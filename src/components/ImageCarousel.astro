---
// ImageCarousel.astro
// Sliding carousel with arrow navigation. Uses a seamless-loop track: a
// clone of the last slide is prepended and a clone of the first slide is
// appended, so there is always a neighbor to slide into view in either
// direction. After each slide-into-a-clone transition finishes, the track
// jumps (without a transition) back onto the matching real slide — the
// jump is invisible because the clone and the real slide are identical.
import { Image } from 'astro:assets';

import start2 from '../assets/images/start/start-2.jpg';
import start3 from '../assets/images/start/start-3.jpg';
import start4 from '../assets/images/start/start-4.jpg';

const slides = [
  { image: start2, alt: 'Semmelweisklinik space 1' },
  { image: start3, alt: 'Semmelweisklinik space 2' },
  { image: start4, alt: 'Semmelweisklinik space 3' },
];

const loopSlides = [slides[slides.length - 1], ...slides, slides[0]];
---

<div class="wide-slideshow-container">
  <button type="button" class="wide-slideshow-arrow wide-slideshow-left-button" aria-label="Previous slide">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="wide-slideshow-arrow wide-slideshow-right-button" aria-label="Next slide">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div class="wide-slideshow">
    <div class="wide-slideshow-track">
      {loopSlides.map((slide, i) => (
        <Image
          src={slide.image}
          alt={slide.alt}
          class="wide-slideshow-slide"
          widths={[400, 600, 800]}
          sizes="(max-width: 800px) 100vw, (max-width: 1200px) 50vw, 33vw"
          aria-hidden={i === 0 || i === loopSlides.length - 1 ? 'true' : undefined}
        />
      ))}
    </div>
  </div>
</div>

<script>
  function initCarousel() {
    const container = document.querySelector('.wide-slideshow-container');
    if (!container) return;

    const track = container.querySelector('.wide-slideshow-track');
    const leftButton = container.querySelector('.wide-slideshow-left-button');
    const rightButton = container.querySelector('.wide-slideshow-right-button');
    if (!track || !leftButton || !rightButton) return;

    const slideEls = Array.from(track.children);
    const realCount = slideEls.length - 2; // exclude the leading/trailing clones
    let position = 1; // index into slideEls; 1 is the first real slide
    let isAnimating = false;

    function stepWidth() {
      if (slideEls.length < 2) return 0;
      return slideEls[1].offsetLeft - slideEls[0].offsetLeft;
    }

    function applyTransform(withTransition) {
      track.style.transition = withTransition ? '' : 'none';
      track.style.transform = `translateX(-${stepWidth() * position}px)`;
      if (!withTransition) {
        // Force a reflow so the disabled transition takes effect before
        // it's re-enabled, otherwise the jump itself would animate.
        void track.offsetHeight;
        track.style.transition = '';
      }
    }

    function goTo(newPosition) {
      if (isAnimating) return;
      isAnimating = true;
      position = newPosition;
      applyTransform(true);
    }

    function handleTransitionEnd(event) {
      if (event.target !== track || event.propertyName !== 'transform') return;
      isAnimating = false;
      if (position === slideEls.length - 1) {
        position = 1;
        applyTransform(false);
      } else if (position === 0) {
        position = realCount;
        applyTransform(false);
      }
    }

    leftButton.addEventListener('click', () => goTo(position - 1));
    rightButton.addEventListener('click', () => goTo(position + 1));
    track.addEventListener('transitionend', handleTransitionEnd);

    let resizeFrame;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => applyTransform(false));
    });

    applyTransform(false);
  }

  // Deferred module scripts run after the DOM is parsed, so DOMContentLoaded
  // may have already fired; initialize immediately if the DOM is ready.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
  // Re-initialize after client-side (View Transitions) navigations.
  document.addEventListener('astro:page-load', initCarousel);
</script>

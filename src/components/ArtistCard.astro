---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  name: string;
  slug: string;
  profileImage: ImageMetadata;
}

const { name, slug, profileImage } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<div style="max-width: min-content;">
  <a href={`/${lang}/artists/${slug}`} style="border-bottom: none;">
    <Image
      class="artist-image"
      src={profileImage}
      alt={name}
      widths={[230, 460, 640]}
      sizes="(max-width: 800px) min(320px, 80vw), 230px"
    />
  </a>
  <p style="margin-top: 5px;">
    <a href={`/${lang}/artists/${slug}`}>{name}</a>
  </p>
</div>

---
// ImageViewer.astro
// Global lightbox overlay. Include it once per page that has a gallery; it
// then handles every image carrying `.artist-detail-image` or
// `.room-gallery-image`.
//
// Two sources of full-size images, because the two collections are at
// different stages of the image migration:
//   - Rooms go through astro:assets, so the page pre-generates a large WebP
//     and passes its URL in `data-full`. Preferred whenever present.
//   - Artists are still plain files under public/, where the thumbnail lives
//     in artists/preview/ and the full version in artists/original/ under the
//     same basename. Falling back to that swap until artists migrate too.
---

<div class="imageViewerWrapper">
  <div class="imageViewerContainer">
    <img class="imageViewerImage" alt="Enlarged view" />
  </div>
</div>

<script>
  function initImageViewer() {
    const imageViewerWrapper = document.querySelector('.imageViewerWrapper') as HTMLElement | null;
    const imageViewerImage = document.querySelector('.imageViewerImage') as HTMLImageElement | null;

    if (!imageViewerWrapper || !imageViewerImage) return;

    // Close viewer when clicking anywhere
    document.documentElement.addEventListener('click', () => {
      imageViewerWrapper.classList.remove('is-open');
    });

    const lightboxImages = document.querySelectorAll('.artist-detail-image, .room-gallery-image');
    lightboxImages.forEach((img) => {
      img.addEventListener('click', (event) => {
        event.stopPropagation();

        const imgElement = event.currentTarget as HTMLImageElement;
        const preGenerated = imgElement.dataset.full;

        if (preGenerated) {
          imageViewerImage.src = preGenerated;
        } else {
          const imagePath = imgElement.src;
          const imageName = imagePath.split('/').pop();

          if (imagePath.includes('/artists/') && !imagePath.includes('/original/')) {
            // The original/ counterpart is assumed to exist, but it does not
            // always — Leo Begeré has a preview with no original, and any
            // artist added preview-only from now on will be the same. Fall
            // back to the thumbnail rather than showing a broken image.
            imageViewerImage.onerror = () => {
              imageViewerImage.onerror = null;
              imageViewerImage.src = imagePath;
            };
            imageViewerImage.src = `/images/artists/original/${imageName?.replace(/\.[^/.]+$/, '.jpg')}`;
          } else {
            imageViewerImage.src = imagePath;
          }
        }

        imageViewerWrapper.classList.add('is-open');
      });
    });
  }

  // Deferred module scripts run after the DOM is parsed, so DOMContentLoaded
  // may have already fired; initialize immediately if the DOM is ready.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageViewer);
  } else {
    initImageViewer();
  }
  // Re-initialize on Astro page transitions.
  document.addEventListener('astro:page-load', initImageViewer);
</script>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  name: { en: string; de: string };
  tagline?: { en: string; de: string };
  slug: string;
  // Room images go through `image()` in the collection schema, so this is an
  // ImageMetadata object from Sharp — not a URL string.
  image: ImageMetadata;
}

const { name, tagline, slug, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Room names stay German in both locales — see src/content.config.ts.
const displayName = name.de;
const displayTagline = tagline?.[lang] ?? tagline?.de ?? '';
---

<div class="grid-2col-item">
  <a href={`/${lang}/rooms/${slug}`} class="naked-link">
    <Image
      class="grid-2col-image program-image"
      src={image}
      alt={displayName}
      widths={[400, 800, 1200]}
      sizes="(max-width: 800px) 90vw, 45vw"
    />
  </a>
  <p class="only-desktop text-32">{displayName}</p>
  <p class="only-mobile text-28">{displayName}</p>
  {
    displayTagline && (
      <p>
        {displayTagline}
        <br />
        <a href={`/${lang}/rooms/${slug}`}>{t('rooms.learn_more')}</a>
      </p>
    )
  }
</div>

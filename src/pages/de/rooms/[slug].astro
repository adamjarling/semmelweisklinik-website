---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export const prerender = true;

export async function getStaticPaths() {
  const rooms = await getCollection("rooms");
  return rooms.map((room) => ({
    params: { slug: room.slug },
    props: { room },
  }));
}

const { room } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { name, location, description, specs, images } = room.data;
const displayName = name.de;
const displayLocation = location?.de;
const displayDescription = description?.de;
const displaySize = specs?.size?.de;
const displayCapacity = specs?.capacity?.de;
const displayFeatures = specs?.features?.de;
---

<BaseLayout title={`Semmelweisklinik • ${displayName}`} description={displayDescription} ogImage={images?.[0]?.src}>
  <div class="page-wrapper">
    <div class="content container-wide">
      <h1 class="hero-title">{displayName}</h1>
      {displayDescription && <p class="mt-20">{displayDescription}</p>}

      <div class="grid-2col mt-50">
        <div class="grid-2col-item room-specs">
          {
            displayLocation && (
              <>
                <h2>{t("rooms.detail_location")}</h2>
                <p>{displayLocation}</p>
              </>
            )
          }

          {
            displaySize && (
              <>
                <h2>{t("rooms.detail_size")}</h2>
                <p>{displaySize}</p>
              </>
            )
          }

          {
            displayCapacity && (
              <>
                <h2>{t("rooms.detail_capacity")}</h2>
                <p>{displayCapacity}</p>
              </>
            )
          }

          {
            displayFeatures && displayFeatures.length > 0 && (
              <>
                <h2>{t("rooms.detail_features")}</h2>
                <ul>
                  {displayFeatures.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              </>
            )
          }
        </div>

        <div>
          <p><strong>{t("rooms.detail_contact_prompt")}</strong></p>
          <p class="mt-10">
            <a href="https://forms.cloud.microsoft/pages/responsepage.aspx?id=k4T7IDJCqkGd0n-P_3sfEFN5efuep7RNp8DZIoA20jBUNVZaVERaTFRaQjlTTFc3UEJaQlNJQk1VVS4u&route=shorturl" target="_blank" rel="noopener noreferrer">
              {t("rooms.detail_reserve_cta")} {displayName}
            </a>
          </p>
        </div>

        {
          images &&
            images.map((img) => (
              <div>
                <div class="grid-img-wrapper">
                  <img
                    class="grid-2col-image"
                    src={img.src}
                    alt={img.caption?.de ?? displayName}
                  />
                </div>
                {img.caption?.de &&
                  (() => {
                    const [title, desc] = img.caption.de.split(" — ");
                    return (
                      <p class="mt-10">
                        <strong>{title}</strong>
                        {desc && (
                          <>
                            <br />
                            {desc}
                          </>
                        )}
                      </p>
                    );
                  })()}
              </div>
            ))
        }
      </div>

      <div class="mt-50">
        <h2 class="mb-25">{t('rooms.calendar_title')}</h2>
        <p>{t('rooms.calendar_coming_soon')}</p>
        {/* <iframe
          src="https://kalender.digital/1d670462e848c0d7b0d0"
          width="100%"
          height="600"
          frameborder="0"
          loading="lazy"
          title="Raumbelegungskalender"
        ></iframe> */}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .room-specs > * + * {
    margin-top: 4px;
  }
</style>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RoomCard from '../../../components/RoomCard.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const rooms = await getCollection('rooms');
const sortedRooms = rooms.sort((a, b) => {
  const orderA = a.data.sortOrder ?? 999;
  const orderB = b.data.sortOrder ?? 999;
  return orderA - orderB;
});
---

<BaseLayout title={`Semmelweisklinik • ${t('nav.rooms')}`}>
  <div class="page-wrapper">
    <div class="content container-wide">
      <h1 class="hero-title">{t('rooms.title')}</h1>

      <div class="grid-2col mt-50">
        {sortedRooms.map((room) => (
          <RoomCard
            name={room.data.name}
            tagline={room.data.tagline}
            slug={room.id}
            image={room.data.images?.[0]?.src || '/images/rooms/placeholder.jpg'}
          />
        ))}
      </div>

      <div class="grid-2col mt-80">
        <div class="grid-2col-item">
          <h2>{t('rooms.rent_heading')}</h2><br />
          <p>{t('rooms.rent_description_1')}</p><br />
          <p>{t('rooms.rent_description_2')}</p><br />
          <p>{t('rooms.rent_description_3')}</p><br />
          <p>
            {t('rooms.rent_contact')}<br />
            <a href="mailto:programm@semmelweisklinik.at">programm@semmelweisklinik.at</a>
          </p>
        </div>
      </div>

      <div class="grid-2col mt-80">
        <div class="grid-2col-item">
          <h2>{t('rooms.pricing_rooms_heading')}</h2><br />
          <p>{t('rooms.pricing_rooms_intro')}</p><br />
          <p><b>Hybridraum</b><br />{t('rooms.pricing_hybridraum_rates')}</p><br />
          <p><b>Bewegungsraum</b><br />{t('rooms.pricing_bewegungsraum_rates')}</p><br />
          <p><b>Küche</b><br />{t('rooms.pricing_kueche_rates')}</p><br />
          <p><b>Waschküche</b><br />{t('rooms.pricing_waschkueche_rates')}</p><br />
          <p><b>Dachgeschoss</b><br />{t('rooms.pricing_attic_rates')}</p><br />
          <p>{t('rooms.pricing_longer_use')}</p>
        </div>
      </div>

      <div class="grid-2col mt-80">
        <div class="grid-2col-item">
          <h2>{t('rooms.pricing_additional_heading')}</h2><br />
          <p><b>{t('rooms.pricing_event_support_name')}</b><br />{t('rooms.pricing_event_support_price')}<br />{t('rooms.pricing_event_support_note')}</p><br />
          <p><b>{t('rooms.pricing_security_name')}</b><br />{t('rooms.pricing_security_price')}<br />{t('rooms.pricing_security_note')}</p><br />
          <p><b>{t('rooms.pricing_tech_support_name')}</b><br />{t('rooms.pricing_tech_support_price')}</p><br />
          <p><b>{t('rooms.pricing_documentation_name')}</b><br />{t('rooms.pricing_documentation_price')}</p><br />
          <p><b>{t('rooms.pricing_setup_name')}</b><br />{t('rooms.pricing_setup_price')}</p><br />
          <p><b>{t('rooms.pricing_cleaning_name')}</b><br />{t('rooms.pricing_cleaning_price')}</p><br />
          <p>{t('rooms.pricing_asterisk_note')}</p><br />
          <p>{t('rooms.pricing_tech_rental')}</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

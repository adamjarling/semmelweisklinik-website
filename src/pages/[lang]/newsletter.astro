---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalePaths, useTranslations } from '../../i18n/utils';

// Builds this page once per locale: /en/... and /de/...
export function getStaticPaths() {
  return getLocalePaths();
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={`Semmelweisklinik • ${t('newsletter.title')}`}
  description={t('newsletter.description')}
>
  <div class="page-wrapper">
    <div class="content container-narrower">
      <h1 class="hero-title">{t('newsletter.title')}</h1>
      <p class="mt-50">{t('newsletter.description')}</p>
      <p class="mt-20 mb-50">
        {t('newsletter.privacy_info')}{' '}
        <a href={`/${lang}/datenschutz`}>{t('newsletter.privacy_link_text')}</a>
        {/* English only: the policy body itself is German. Empty in `de`. */}
        {t('newsletter.privacy_note') && <> {t('newsletter.privacy_note')}</>}.
      </p>

      <iframe
        width="540"
        height="800"
        src="https://9d23e94a.sibforms.com/serve/MUIFAJnE5e0flJF19-r4ImZauAfnM8dcH2mFkuxj6ATP7R-T4IqXKmkb6jID4VBS1OalzJfKxPr9IYN_dsEhWLK6mbO3SehTF4raN9BdxNi9Y2X7I83UX6ktkRLOU4B7zA_eCewwuVQ5uyc8eBiNnDv9OSq0U5aJ4QJfI5rZGkNfAGM6eL61Gzy7Uisc9CYZIBbIxA0wRCUkdwFm"
        frameborder="0"
        scrolling="auto"
        allowfullscreen
        class="newsletter-iframe"
        title={t('newsletter.title')}></iframe>
    </div>
  </div>
</BaseLayout>

<style>
  .newsletter-iframe {
    display: block;
    margin-left: auto;
    margin-right: auto;
    max-width: 100%;
  }
</style>

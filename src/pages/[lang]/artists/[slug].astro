---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ImageViewer from '../../../components/ImageViewer.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, getLocalePaths, useTranslations } from '../../../i18n/utils';

export const prerender = true;

// Two params, so this builds locales × artists: 2 × 27 = 54 pages.
export async function getStaticPaths() {
  const artists = await getCollection('artists');
  return getLocalePaths().flatMap(({ params: { lang } }) =>
    artists.map((artist) => ({
      params: { lang, slug: artist.id },
      props: { artist },
    })),
  );
}

const { artist } = Astro.props;
const { Content } = await render(artist);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  name,
  location,
  email,
  phone,
  website,
  instagram,
  facebook,
  github,
  profileImage,
  galleryImages,
  bio,
} = artist.data;

const bioParagraphs = bio?.[lang]
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

const artistDescription = (bio?.[lang] ?? artist.body)
  ?.replace(/[#*_`[\]()!]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);

// The gallery (and the profile photo, which is also clickable) renders
// responsive thumbnails, but the lightbox wants the largest sensible
// version. Pre-generate one per image and hand it to ImageViewer via
// `data-full` — never upscaling past the source. Mirrors rooms/[slug].astro.
const profileFull = (await getImage({ src: profileImage, width: 2000, format: 'webp' })).src;
const galleryFull = await Promise.all(
  (galleryImages ?? []).map(async (img) => ({
    src: img,
    full: (await getImage({ src: img, width: Math.min(2000, img.width), format: 'webp' })).src,
  })),
);
---

<BaseLayout
  title={`Semmelweisklinik • ${name}`}
  description={artistDescription}
  ogImage={profileImage.src}
>
  <ImageViewer />
  <div class="page-wrapper">
    <div class="content container-wide">
      <div class="artist-detail-section">
        <h1 class="only-mobile hero-title hero-title-no-margin">{name}</h1>

        <Image
          class="artist-detail-image"
          src={profileImage}
          alt={name}
          data-full={profileFull}
          widths={[320, 640, 960]}
          sizes="min(320px, 80vw)"
        />

        <div class="artist-info-container">
          <h1 class="only-desktop hero-title hero-title-desktop">{name}</h1>

          {
            location && (
              <div class="social-link-row artist-location-row">
                <img class="icon-21" src="/svg/map-pin.svg" alt="Location" />
                <p>{location}</p>
              </div>
            )
          }

          {
            website && (
              <div class="social-link-row mt-10">
                <img class="icon-small" src="/svg/link.svg" alt="Website" />
                <p>
                  <a href={website} target="_blank" rel="noopener noreferrer">
                    {t('artists.website')}
                  </a>
                </p>
              </div>
            )
          }

          {
            instagram && (
              <div class="social-link-row mt-10">
                <img class="icon-small" src="/svg/link.svg" alt="Instagram" />
                <p>
                  <a href={instagram} target="_blank" rel="noopener noreferrer">
                    Instagram
                  </a>
                </p>
              </div>
            )
          }

          {
            facebook && (
              <div class="social-link-row mt-10">
                <img class="icon-small" src="/svg/link.svg" alt="Facebook" />
                <p>
                  <a href={facebook} target="_blank" rel="noopener noreferrer">
                    Facebook
                  </a>
                </p>
              </div>
            )
          }

          {
            github && (
              <div class="social-link-row mt-10">
                <img class="icon-small" src="/svg/link.svg" alt="GitHub" />
                <p>
                  <a href={github} target="_blank" rel="noopener noreferrer">
                    GitHub
                  </a>
                </p>
              </div>
            )
          }

          {
            email && (
              <div class="social-link-row mt-10">
                <img class="icon-21" src="/svg/@.svg" alt="Email" />
                <p>{email}</p>
              </div>
            )
          }

          {
            phone && (
              <div class="social-link-row mt-10">
                <img class="icon-19" src="/svg/phone.svg" alt="Phone" />
                <p>{phone}</p>
              </div>
            )
          }

          <div class="mt-20">
            {bioParagraphs ? bioParagraphs.map((paragraph) => <p>{paragraph}</p>) : <Content />}
          </div>
        </div>
      </div>

      {
        galleryFull.length > 0 && (
          <div class="artist-more-works-section">
            <h2 class="mb-25">{t('artists.selected_works')}</h2>
            <div class="artist-more-works-gallery">
              {galleryFull.map((img) => (
                <Image
                  class="artist-detail-image"
                  src={img.src}
                  alt={`${name} work`}
                  data-full={img.full}
                  widths={[320, 640, 960]}
                  sizes="min(320px, 80vw)"
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

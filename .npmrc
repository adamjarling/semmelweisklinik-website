publish-branch=main
# Supply-chain release-cooldown gate. Value is an integer number of MINUTES
# (0 disables it). "0h" is not valid syntax and left the gate effectively on,
# which blocked installs of freshly published transitive deps (e.g. sharp's
# platform binaries). Disabled so CI installs deterministically from the
# committed lockfile. To re-enable, set minutes (e.g. 1440 = 1 day) and add a
# minimumReleaseAgeExclude list in pnpm-workspace.yaml for sharp / @img/*.
minimum-release-age=0